{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "running-directory",
  "main": "server/worker.ts",
  "compatibility_date": "2026-08-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist/public",
    "binding": "ASSETS",
    "run_worker_first": ["/*", "!/assets/*"]
  },
  "routes": [
    {
      "pattern": "running.services/*",
      "zone_name": "running.services"
    },
    {
      "pattern": "www.running.services/*",
      "zone_name": "running.services"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "running-directory-db",
      "database_id": "925703f3-ea80-4b0a-995b-98ffc51a306a",
      "migrations_dir": "./migrations"
    }
  ],
  "vars": {
    "APP_BASE_URL": "https://running.services",
    "BASE_URL": "https://running.services",
    "PUBLIC_BASE_URL": "https://running.services"
  },
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
